{
  "permissions": {
    "deny": [
      "Edit(./reference/**)",
      "Write(./reference/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          { "type": "command", "command": "py -3 .claude/hooks/guard.py" }
        ]
      }
    ]
  }
}
